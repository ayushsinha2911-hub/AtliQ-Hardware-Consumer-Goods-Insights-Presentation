 9. Which channel helped to bring more gross sales in the fiscal year 2021 and the percentage of contribution?   final output contains these fields, channel gross_sales_mln percentage
With cte1 as(
SELECT 
    c.channel,
    ROUND(SUM((s.sold_quantity * g.gross_price) * 1000000),
            2) AS gross_sales_mln
FROM
    gdb023.fact_sales_monthly s
        JOIN
    fact_gross_price g ON g.product_code = s.product_code
        JOIN
    dim_customer c ON c.customer_code = s.customer_code
WHERE
    s.fiscal_year = 2021
GROUP BY channel),
cte2 as(select * ,sum(gross_sales_mln) over() as total_gross_sales_mln
from cte1) 
SELECT 
    *,
    ROUND((gross_sales_mln / total_gross_sales_mln) * 100,
            2) AS pct_contribution 
FROM
    cte2
ORDER BY pct_contribution  DESC ;
